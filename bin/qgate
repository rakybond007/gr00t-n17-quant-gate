#!/usr/bin/env bash
# Entry point for the qgate toolkit.
#
# This has to survive `ssh <host> 'qgate ...'`, which runs a non-login shell
# with almost no environment: no HOME on some setups, no PATH to conda, no
# profile sourced. So nothing here may assume a variable exists, and the
# interpreter is found by looking rather than by PATH.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The package lives under vlm_gate/ in the working tree and under tools/ in
# the portable checkout; both are offered so one script serves both.
export PYTHONPATH="${here}/../vlm_gate:${here}/../tools:${PYTHONPATH:-}"

py="${QGATE_PYTHON:-}"
if [[ -z "$py" ]]; then
  # ${HOME:-} rather than $HOME: a bare ssh command may have neither.
  home="${HOME:-$(cd "${here}/../../.." && pwd)}"
  for c in "${home}/miniconda3/envs/quant_gate/bin/python" \
           "/opt/conda/envs/quant_gate/bin/python" \
           "${home}/miniconda3/bin/python"; do
    if [[ -x "$c" ]]; then py="$c"; break; fi
  done
fi
if [[ -z "$py" ]]; then
  py="$(command -v python3 || true)"
fi
if [[ -z "$py" ]]; then
  echo "qgate: no python found; set QGATE_PYTHON=/path/to/python" >&2
  exit 127
fi
exec "$py" -m qgate.cli "$@"
