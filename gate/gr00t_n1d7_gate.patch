+    def attach_quant_gate(self, gate_layer: int, act_dim: int = 0,
+                          loss_weight: float = 1.0, nheads: int = 8):
+        """양자화 신뢰도 게이트를 백본에 붙인다.
+
+        액션 헤드는 최상위 레이어를 쓰고, 게이트는 `gate_layer` 를 쓴다. 상위 레이어를
+        unfreeze 한 채 공동 파인튜닝하면 두 손실이 서로 다른 깊이에 걸려 레이어가
+        각자 특화된다. 백본 forward 는 정책이 어차피 하므로 추가 비전 연산은 0.
+
+        출력 타겟은 청크당 스칼라 P(quantize) 하나다.
+        """
+        from gr00t.model.modules.quant_gate import QuantGateHead, patch_backbone_gate_tap
+
+        # hidden_states[k] 는 k 번째 레이어의 **출력**이므로(0 은 임베딩) 게이트 손실은
+        # 레이어 0..k-1 로만 흐른다. 탭이 동결 구간에 있으면 게이트가 백본을 전혀 못 바꾸고,
+        # 그래도 학습은 정상으로 보이며 손실도 내려간다 — 레이어 특화만 조용히 사라진다.
+        n_layers = len(self.backbone.model.language_model.layers)
+        trainable = sorted({
+            int(n.split(".layers.")[1].split(".")[0])
+            for n, p in self.backbone.named_parameters()
+            if p.requires_grad and ".layers." in n
+        })
+        if not trainable:
+            raise ValueError(
+                "백본에 학습 가능한 레이어가 없다. attach_quant_gate 전에 "
+                "set_trainable_parameters(..., tune_top_llm_layers=N) 을 먼저 호출할 것."
+            )
+        if gate_layer - 1 < trainable[0]:
+            raise ValueError(
+                f"gate_layer={gate_layer} 는 게이트 손실을 레이어 0..{gate_layer - 1} 로만 보내는데, "
+                f"학습 가능한 레이어는 {trainable[0]}..{trainable[-1]} 이다. "
+                f"게이트가 백본을 전혀 바꾸지 못한다. "
+                f"gate_layer >= {trainable[0] + 1} 로 올리거나 tune_top_llm_layers 를 늘릴 것."
+            )
+        if gate_layer > n_layers:
+            raise ValueError(f"gate_layer={gate_layer} 가 레이어 수 {n_layers} 를 넘는다.")
+        shaped = [l for l in trainable if l <= gate_layer - 1]
+        print(f"[gate] 탭 hidden_states[{gate_layer}] — 게이트가 형성하는 레이어 {shaped}, "
+              f"액션 전용 {[l for l in trainable if l not in shaped]}", flush=True)
+
+        patch_backbone_gate_tap(self.backbone, gate_layer)
+        dim = self.backbone.model.config.text_config.hidden_size
+        self.quant_gate = QuantGateHead(dim, nheads=nheads, act_dim=act_dim).to(self.device)
+        self.quant_gate_layer = gate_layer
+        self.quant_gate_weight = loss_weight
+        return self.quant_gate
+
